{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-qq-mail-work",
  "version": "0.1.0",
  "identifier": "com.litongjava.tauri.qq.mail.work",
  "build": {
    "devUrl": "https://mail.qq.com/",
    "frontendDist": "https://mail.qq.com/"
  },
  "app": {
    "security": {
      "csp": null,
      "capabilities": []
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 1000,
        "resizable": true,
        "title": "QQ Mail Work",
        "width": 1500,
        "url": "https://mail.qq.com/"
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  }
}
